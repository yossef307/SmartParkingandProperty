@model IEnumerable<SmartParkingF.API.Models.Reservation>

@{
    ViewData["Title"] = "Reservations List";
}

<h1>Reservations Index</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New Reservation</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Property)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParkingSpot)
            </th>
            <th>
                @* ✅ تم التعديل لعرض تسمية "البريد الإلكتروني" من خلال علاقة المستخدم *@
                User Email
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CarPlateNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Property.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkingSpot.SpotNumber)
                </td>
                <td>
                    @* ✅ التعديل الجوهري هنا: الوصول للإيميل عبر كائن User المرتبط *@
                    @Html.DisplayFor(modelItem => item.User.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CarPlateNumber)
                </td>
                <td>
                    @item.StartTime.ToString("g")
                </td>
                <td>
                    @item.EndTime.ToString("g")
                </td>
                <td>
                    <strong>@Html.DisplayFor(modelItem => item.TotalPrice) ج.م</strong>
                </td>
                <td>
                    <span class="badge @(item.Status == "Confirmed" ? "bg-success" : "bg-warning")">
                        @Html.DisplayFor(modelItem => item.Status)
                    </span>
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>