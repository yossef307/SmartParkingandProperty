@model SmartParkingF.API.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this reservation?</h3>
<div>
    <h4>Reservation Details</h4>
    <hr />
    <dl class="row">
        @* عرض اسم الفيلا المرتبطة بالحجز *@
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Property)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Property.Name)
        </dd>

        @* عرض رقم الركنة *@
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ParkingSpot)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ParkingSpot.SpotNumber)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UserEmail)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UserEmail)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CarPlateNumber)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CarPlateNumber)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.StartTime)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.StartTime)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.EndTime)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.EndTime)
        </dd>

        @* ✅ التعديل الأهم: تغيير Amount إلى TotalPrice *@
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TotalPrice)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TotalPrice) ج.م
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.Status == "Confirmed" ? "bg-success" : "bg-danger")">
                @Html.DisplayFor(model => model.Status)
            </span>
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>